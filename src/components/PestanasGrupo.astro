---
// Pestañas del grupo de torneos que crea el organizador en la fuente (en
// info64, «Preferente · Primera · Segunda»), bajo la cabecera del torneo. Sólo
// los torneos guardados (getTournamentGroup); con uno solo, el propio, no
// pinta nada. Van sin caja, con la raya de las pestañas, para que no se
// confundan con el selector de rondas (Segmented). Sin JavaScript ni más
// lecturas de D1.
import type { GroupTab } from '../lib/db/tournaments'

interface Props {
	tabs: readonly GroupTab[]
	/** El torneo de la página. */
	current: number
}

const { tabs, current } = Astro.props
---

{
	tabs.length > 1 && (
		<nav class="group-tabs" aria-label="Torneos del grupo">
			<ul>
				{tabs.map((tab) => (
					<li>
						<a href={`/torneos/${tab.id}`} aria-current={tab.id === current ? 'page' : undefined}>
							{tab.label}
						</a>
					</li>
				))}
			</ul>
		</nav>
	)
}

<style>
	/* Justo bajo la cabecera de la página (.page-head), más cerca de ella que del contenido. */
	.group-tabs {
		margin: calc(-1 * var(--space-3)) 0 var(--space-5);
	}

	/*
	 * Un grupo puede tener muchas pestañas o rótulos largos: en una fila, que se
	 * desplaza como el menú de la cabecera y se abre en la actual. Una sombra
	 * en el borde dice que hay más por ese lado, como en .table-wrap: sombras
	 * fijas y, encima, tapas del color de la página que se desplazan con la
	 * lista.
	 *
	 * La raya de debajo es el primer fondo y no un borde: la lista recorta lo
	 * que sale de su caja, y así el subrayado de la actual la tapa, como en
	 * PestanasJugador.
	 *
	 * Por lo mismo, el anillo de foco va por dentro del enlace, que lleva un
	 * relleno a los lados para no pisar el texto. El hueco entre pestañas es
	 * el de PestanasJugador menos ese relleno, y el margen negativo deja la
	 * primera a plomo con el título.
	 */
	ul {
		display: flex;
		gap: 0 var(--space-4);
		margin: 0 calc(-1 * var(--space-1));
		padding: 0;
		scroll-padding-inline: var(--space-5);
		list-style: none;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: none;
		background:
			linear-gradient(var(--border), var(--border)) bottom / 100% 1px no-repeat,
			linear-gradient(to right, var(--bg) var(--space-3), transparent) left / var(--space-6) 100% no-repeat local,
			linear-gradient(to left, var(--bg) var(--space-3), transparent) right / var(--space-6) 100% no-repeat local,
			linear-gradient(to right, var(--border-strong), transparent) left / var(--space-3) 100% no-repeat,
			linear-gradient(to left, var(--border-strong), transparent) right / var(--space-3) 100% no-repeat;
	}

	li {
		display: flex;
	}

	/* De 44 px de alto: se tocan con el dedo. */
	a {
		display: flex;
		align-items: center;
		min-block-size: 2.75rem;
		padding-inline: var(--space-1);
		border-block-end: 3px solid transparent;
		color: var(--text-muted);
		font-size: var(--text-s);
		font-weight: var(--weight-strong);
		text-decoration: none;
		white-space: nowrap;
	}

	a:focus-visible {
		outline-offset: -2px;
	}

	a:hover {
		border-block-end-color: var(--border-strong);
		color: var(--text);
	}

	/* Si no caben, la lista se abre desplazada hasta la actual (scroll-initial-target). */
	a[aria-current] {
		border-block-end-color: var(--accent);
		color: var(--accent);
		scroll-initial-target: nearest;
	}

	/*
	 * En alto contraste, la actual con el color de selección del sistema, como
	 * el menú. El navegador quita los degradados: la raya pasa a ser un borde.
	 */
	@media (forced-colors: active) {
		ul {
			border-block-end: 1px solid;
		}

		a {
			border-block-end-color: Canvas;
		}

		a[aria-current] {
			border-block-end-color: Highlight;
		}
	}

	/* En papel no llevan a ninguna parte. */
	@media print {
		.group-tabs {
			display: none;
		}
	}
</style>
