---
// Una línea principal del rival cruzada con tus partidas: dónde dejas de
// conocerla y qué hay a partir de ahí (ver crossReference en lib/chess/dossier.ts).
import type { CrossPoint, MoveCount } from '../../lib/chess/dossier'
import { parseLine } from '../../lib/chess/repertoire'
import { formatGames, formatLine, formatMove, formatNumber } from '../../lib/format'
import ScoreBar from '../repertorio/ScoreBar.astro'

interface Props {
	cross: CrossPoint
	/** Nombre del rival para los textos. */
	name: string
}

const { cross, name } = Astro.props
const prefix = parseLine(cross.moves.join(' ')).moves

/** "3.d4" o "3…d6": la jugada que sigue a `moves` con su número. */
function label(moves: string[], uci: string): string {
	const move = parseLine([...moves, uci].join(' ')).moves.at(-1)
	return move ? formatMove(move.ply, move.san) : uci
}

// La línea, aparte de «Tras»: las jugadas van con las figuras (.moves) y la
// prosa no, porque las mayúsculas de los nombres saldrían como piezas.
const after = prefix.length ? formatLine(prefix) : null
const list = (moves: string[], counts: MoveCount[]) =>
	counts.map((c) => `${label(moves, c.uci)} (${formatNumber(c.stats.games)})`).join(', ')
const yourMain = cross.yourMoves[0]
---

<p class="cross">
	{
		cross.kind === 'known' && (
			<>
				<span class="tag known">La conoces</span> Llegas al final de la línea en {formatGames(cross.yours.games)}:{' '}
				<ScoreBar stats={cross.yours} />
			</>
		)
	}
	{
		cross.kind === 'new-for-you' && (
			<>
				<span class="tag new">Nueva para ti</span>{' '}
				{after ? <>Tras <span class="moves">{after}</span></> : 'Desde la primera jugada'}, {name} juega{' '}
				<span class="moves">{label(cross.moves, cross.lineMove!)}</span> y a ti nunca te lo han jugado: prepáralo.
			</>
		)
	}
	{
		cross.kind === 'you-deviate' &&
			(yourMain ? (
				<>
					<span class="tag deviate">Te desvías</span>{' '}
					{after ? <>Tras <span class="moves">{after}</span></> : 'Desde la primera jugada'}, tú sueles jugar{' '}
					<span class="moves">{list(cross.moves, cross.yourMoves)}</span> y no{' '}
					<span class="moves">{label(cross.moves, cross.lineMove!)}</span>.{' '}
					{cross.rivalAfter ? (
						<>
							Contra <span class="moves">{label(cross.moves, yourMain.uci)}</span>, {name} tiene{' '}
							{formatGames(cross.rivalAfter.stats.games)}
							{cross.rivalAfter.replies.length > 0 && (
								<>
									: <span class="moves">{list([...cross.moves, yourMain.uci], cross.rivalAfter.replies)}</span>
								</>
							)}
							.
						</>
					) : (
						<>
							{name} nunca se ha encontrado <span class="moves">{label(cross.moves, yourMain.uci)}</span> en estas
							partidas.
						</>
					)}
				</>
			) : (
				<>
					<span class="tag deviate">Hasta aquí</span>{' '}
					{after ? <>Tras <span class="moves">{after}</span></> : 'Desde la primera jugada'}, acaban tus partidas;{' '}
					{name} sigue con <span class="moves">{label(cross.moves, cross.lineMove!)}</span>.
				</>
			))
	}
</p>

<style>
	.cross {
		margin: 0;
		font-size: var(--text-s);
	}

	.moves {
		font-family: var(--font-moves);
	}

	/* La etiqueta (.tag, global) con el color de lo que dice: los de los resultados. */
	.known {
		color: var(--result-win);
	}

	.new {
		color: var(--result-loss);
	}

	.deviate {
		color: var(--result-draw);
	}
</style>
