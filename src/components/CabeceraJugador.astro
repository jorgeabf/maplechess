---
// Cabecera de las páginas que cuelgan de la ficha de un jugador (repertorio,
// dossier): título y, en el hueco, un resumen; debajo, las pestañas de sus
// tres páginas, que llevan de vuelta a la ficha.
import type { TimeClass } from '../lib/chess/timecontrol'
import PestanasJugador from './PestanasJugador.astro'

interface Props {
	fideId: number
	title: string
	/** La página: la pestaña que va marcada. */
	view: 'preparar' | 'repertorio'
	/** Color, periodo y ritmo elegidos, que las pestañas conservan. */
	filters: { color: 'white' | 'black'; period: string; timeClass: TimeClass | null }
	/** Tu propia página (cookie yo; ver isOwn): «Mi ficha», «Mi dossier», «Mi repertorio». */
	own?: boolean
}

const { fideId, title, view, filters, own = false } = Astro.props
---

<header class="page-head">
	<h1>{title}</h1>
	<p class="page-meta"><slot /></p>
</header>
<PestanasJugador fideId={fideId} current={view} own={own} filters={filters} />
