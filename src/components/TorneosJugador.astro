---
// Tabla de torneos de la ficha. La ficha la usa dos veces: los más recientes
// a la vista y los anteriores plegados.
import { madridDate } from '../lib/dates'
import type { ParticipationRow, TournamentScore } from '../lib/db/players'
import { standingProgress } from '../lib/db/standings'
import { formatNumber, formatPlace, formatPoints, formatRange } from '../lib/format'

interface Props {
	tournaments: ParticipationRow[]
	/** Partidas con PGN y puntos en cada torneo (getPlayerSummary). */
	scores: Map<number, TournamentScore>
	/** El jugador de la ficha: el número de partidas lleva a las suyas de ese torneo. */
	fideId: number
}

const { tournaments, scores, fideId } = Astro.props
const today = madridDate(new Date())

/** Puntos sobre partidas o rondas, sin partir (ver .standing): «6½ / 9». */
const outOf = (points: number, of: number | null) => (of ? `${formatPoints(points)} / ${of}` : formatPoints(points))
---

<div class="table-wrap stack tournaments">
	<table class="data-table">
		<thead>
			<tr>
				<th scope="col">Torneo</th>
				<th scope="col">Fechas</th>
				<th scope="col">Lugar</th>
				<th scope="col" class="end">ELO</th>
				<th scope="col" class="end">Nº<br />inicial</th>
				<th scope="col" class="end">Partidas<br />con PGN</th>
				<th scope="col" class="end standing">Puesto<br />y puntos</th>
			</tr>
		</thead>
		<tbody>
			{
				tournaments.map((t) => {
					const score = scores.get(t.tournamentId)
					// «tras la ronda 5» o «en juego» si no es la final (standingProgress).
					const { note, played } = standingProgress({ round: t.standingsRound, rounds: t.rounds }, t.endDate, today)
					return (
						<tr>
							<td class="wrap">
								<a href={`/torneos/${t.tournamentId}`}>{t.tournamentName}</a>
								{/*
									En los torneos por equipos, el número es el tablero: va con el
									equipo, y el puesto, que es el del equipo, también.
								*/}
								{t.team && (
									<span class="team">
										<span class="tag">Equipos</span>{' '}
										<span class="muted">
											{t.team}
											{t.pos !== null && ` (${formatPlace(t.pos)}${note ? `, ${note}` : ''})`}
											{t.startRank ? ` · tablero ${t.startRank}` : null}
										</span>
									</span>
								)}
							</td>
							<td class="num">{formatRange(t.startDate, t.endDate)}</td>
							<td class="city">{t.city}</td>
							{/* Apilada en el móvil (.stack): cada cifra lleva su rótulo, sólo si la hay. */}
							<td class="end num stat">{t.rating && <><span class="cell-label" aria-hidden="true">ELO </span>{t.rating}</>}</td>
							<td class="end num stat">{!t.team && t.startRank ? <><span class="cell-label" aria-hidden="true">Nº inicial </span>{t.startRank}</> : null}</td>
							{/* Sus partidas del torneo, en la lista de la ficha (filtro torneo). */}
							<td class="end num stat">
								{score ? (
									<a href={`/jugadores/${fideId}?torneo=${t.tournamentId}#partidas`} rel="nofollow">
										<span class="cell-label" aria-hidden="true">Partidas con PGN </span>
										{formatNumber(score.games)}
										<span class="visually-hidden"> partidas</span>
									</a>
								) : null}
							</td>
							{/* Los de la clasificación o, sin ella, los de sus partidas con PGN. */}
							<td class="end num stat standing">
								{t.pos !== null && t.points !== null ? (
									<>
										<span class="cell-label" aria-hidden="true">Clasificación </span>
										{`${formatPlace(t.pos)} · ${outOf(t.points, played)}`}
										{note && <span class="round-note">{note}</span>}
									</>
								) : score?.decided ? (
									<><span class="cell-label" aria-hidden="true">Puntos </span>{outOf(score.points, score.decided)}</>
								) : null}
							</td>
						</tr>
					)
				})
			}
		</tbody>
	</table>
</div>

<style>
	/*
	 * «Nº inicial», «Partidas con PGN» y «Puesto y puntos» van en dos líneas
	 * (br): en una, le quitaban unos 100 px a la columna del torneo, que partía
	 * más nombres. El lector de pantalla los oye igual. Todos los rótulos se
	 * apoyan en la raya.
	 */
	.tournaments thead th {
		vertical-align: bottom;
	}

	/* En los torneos por equipos, debajo del nombre del torneo: con qué equipo jugó. */
	.team {
		display: block;
	}

	/*
	 * La ciudad parte línea: entera, una dirección larga hacía desplazarse la
	 * tabla en paralelo. Sin el mínimo de .wrap (12rem), que ensanchaba las
	 * cortas y partía más nombres de torneo.
	 */
	.tournaments .city {
		white-space: normal;
	}

	/*
	 * El puesto y los puntos parten línea antes que ensanchar la tabla, que en
	 * paralelo ya pedía 958 px de los 960: tras «1.º ·», en la nota y en el
	 * rótulo, que entonces va en tres líneas. Así la columna no pide más que
	 * cuando sólo decía los puntos («Puntos», «6½ / 9»). Con sitio, en una
	 * línea y el rótulo en dos.
	 */
	.tournaments .standing {
		white-space: normal;
	}

	/*
	 * Una clasificación que no es la final: «tras la ronda 5», debajo del
	 * puesto y los puntos. Apilada, detrás y tras una coma.
	 */
	.round-note {
		display: block;
		font-size: var(--text-xs);
		color: var(--text-muted);
	}

	/*
	 * Torneos apilados en el móvil (.stack, en global.css): sus cifras (ELO,
	 * número, partidas y puntos) van en su propia línea, debajo de las fechas y
	 * el lugar. El salto es el ::after de la fila, un elemento de todo el ancho
	 * que order pone entre los dos grupos; el orden de lectura no cambia.
	 */
	@container (width < 60rem) {
		.tournaments tr::after {
			content: '';
			flex-basis: 100%;
			order: 1;
		}

		.tournaments .stat {
			order: 2;
		}

		.round-note {
			display: inline;
		}

		.round-note::before {
			content: ', ';
		}
	}
</style>
