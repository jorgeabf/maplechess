---
import { env } from 'cloudflare:workers'
import ApurosReloj from '../components/dossier/ApurosReloj.astro'
import PrimeraJugada from '../components/dossier/PrimeraJugada.astro'
import ResultadosRival from '../components/dossier/ResultadosRival.astro'
import ProximasPartidas from '../components/ProximasPartidas.astro'
import Base from '../layouts/Base.astro'
import { getExample } from '../lib/db/ejemplo'
import { getPairedRounds, getUpcomingGames } from '../lib/db/pairings'
import { getPlayer } from '../lib/db/players'
import { getTotals, latestTournamentsWithGames } from '../lib/db/tournaments'
import {
	displayName,
	formatCount,
	formatGames,
	formatNumber,
	formatRange,
	formatRoundTime,
	givenName
} from '../lib/format'
import { ME_COOKIE, resolveMe } from '../lib/me'
import { dossierHref, TOURNAMENT_TABS, withParams } from '../lib/params'

// Con la cookie yo, el saludo con tu nombre de pila en lugar de la pregunta,
// que en una línea sólo cabe así (hasta 19 caracteres, el p99,9 de la lista
// española, a 360 px). Debajo, tu próxima ronda si ya está emparejada; la
// presentación, sólo sin ronda ni saludo: si te saluda, ya sabes para qué es
// la web. Tu nombre, de tu ficha (getPlayer: de la lista FIDE por la clave o,
// si no estás en ella, de tu último torneo). Si ese FIDE ID no tiene ficha
// (retirado o inexistente), como sin la cookie: sin «Mi ficha», que daría un
// 404, y con la nota de cómo decir quién eres.
const me = resolveMe(null, Astro.cookies.get(ME_COOKIE)?.value).fideId
const [totals, rounds, upcoming, player, stored] = await Promise.all([
	getTotals(env.DB),
	getPairedRounds(env.DB),
	me ? getUpcomingGames(env.DB, me) : [],
	me ? getPlayer(env.DB, me) : null,
	getExample(env.DB)
])
// Bajo el buscador, un ejemplo con tres trozos del dossier de uno de los
// primeros del ranking, calculado de noche (lib/db/ejemplo.ts). Es una
// presentación: como la frase de arriba, no sale si la web ya sabe quién eres.
const example = player ? null : stored
// Debajo, las rondas ya emparejadas que aún no han empezado, las más cercanas:
// de ahí se va a la mesa y al dossier del rival. Seis llenan las filas con una,
// dos y tres columnas. Las demás, en la pestaña «Emparejados» de /torneos. Sólo
// el día que no hay ninguna, los últimos torneos con partidas jugados en España.
const SHOWN = 6
const latest = rounds.length === 0 ? await latestTournamentsWithGames(env.DB, SHOWN) : []
const given = player && givenName(player.name)
// Lo que hay, en una línea: en el móvil, tres tarjetas ocupaban más que la entrada.
const available = [
	formatCount(totals.tournaments, 'torneo', 'torneos'),
	formatCount(totals.players, 'jugador', 'jugadores'),
	formatGames(totals.games)
]
---

<Base
	title="MapleChess · Prepara tu próxima partida de ajedrez"
	description="¿Ya sabes contra quién juegas? Mira qué aperturas juega tu rival, cómo le van y si se apura con el reloj. Gratis y sin registro."
>
	<section class="hero">
		<h1>{given ? `Hola, ${given}` : '¿Contra quién juegas?'}</h1>
		{
			upcoming.length > 0 ? (
				<ProximasPartidas games={upcoming} you hideHeading />
			) : (
				!given && (
					<p class="muted">
						Antes de la ronda, mira qué aperturas juega tu rival, cómo le van y si suele apurarse con el reloj. Gratis y
						sin registro.
					</p>
				)
			)
		}
		<form action="/jugadores" method="get" role="search" class="search">
			<label class="visually-hidden" for="q">Nombre del jugador</label>
			<input
				id="q"
				name="q"
				type="search"
				placeholder="Nombre o FIDE ID"
				autocomplete="off"
				autocorrect="off"
				spellcheck="false"
				minlength="2"
				required
			/>
			<button class="button" type="submit">Buscar</button>
		</form>
		{/* Torneos, todos: los que se juegan esta semana casi nunca tienen partidas todavía. */}
		<p class="links">
			<a href="/partidas">Buscar partidas</a> · <a href="/torneos">Buscar torneos</a>
			{player && <> · <a href={`/jugadores/${player.fideId}`}>Mi ficha</a></>}
		</p>
		{
			!player && (
				<p class="note">¿Juegas torneos? Búscate y pulsa «Soy yo» en tu ficha: aquí verás tu próxima partida.</p>
			)
		}
	</section>

	{/*
		Si no cabe, la línea sólo se corta tras un «·»: cada cifra va con su nombre
		sin partir y el espacio de antes del «·» es de no separación.
	*/}
	<p class="totals muted">
		{
			available.map((item, i) => (
				<>
					{i > 0 && ' · '}
					<span>{item}</span>
				</>
			))
		}
	</p>

	{/*
		Las tarjetas son las del dossier sin filtros, con sus partidas con blancas: las
		mismas cifras que enseña el dossier al abrirlo con el enlace de debajo.
	*/}
	{
		example && (
			<section aria-labelledby="ejemplo">
				<h2 id="ejemplo">Un ejemplo: el n.º {example.rank} de España</h2>
				<div class="example">
					<section class="card" aria-labelledby="ejemplo-blancas">
						<h3 id="ejemplo-blancas">Qué juega con blancas</h3>
						<PrimeraJugada
							summary={example.first}
							color="white"
							href={(moves) =>
								withParams(new URL(`/jugadores/${example.fideId}/repertorio`, Astro.url), { jugadas: moves.join(' ') })
							}
						/>
					</section>
					<section class="card" aria-labelledby="ejemplo-rival">
						<h3 id="ejemplo-rival">Cómo le va según el rival</h3>
						<ResultadosRival byElo={example.byElo} />
					</section>
					<section class="card" aria-labelledby="ejemplo-reloj">
						<h3 id="ejemplo-reloj">Si se apura con el reloj</h3>
						<ApurosReloj clock={example.clock} timeClass={example.timeClass} />
					</section>
				</div>
				<p class="more">
					<a href={dossierHref(example.fideId, 'white')} rel="nofollow">
						Ver el dossier de {displayName(example.name)}
					</a>
				</p>
			</section>
		)
	}

	{
		rounds.length > 0 && (
			<section>
				<h2>Próximas rondas emparejadas</h2>
				<ul class="cards">
					{rounds.slice(0, SHOWN).map((r) => (
						<li class="card">
							<a href={`/torneos/${r.id}#proxima-ronda`}>{r.name}</a>
							<span>
								Ronda {r.round} · {formatRoundTime(r.startsAt)}
							</span>
							<span class="muted num">
								{r.city && `${r.city} · `}
								{formatCount(r.boards, 'mesa', 'mesas')}
							</span>
						</li>
					))}
				</ul>
				{rounds.length > SHOWN && (
					<p class="more">
						<a href={`/torneos?cuando=${TOURNAMENT_TABS.paired}`}>Ver las {formatNumber(rounds.length)} rondas emparejadas</a>
					</p>
				)}
			</section>
		)
	}

	{
		latest.length > 0 && (
			<section>
				<h2>Últimos torneos con partidas</h2>
				<ul class="cards">
					{latest.map((t) => (
						<li class="card">
							<a href={`/torneos/${t.id}`}>{t.name}</a>
							<span class="muted">
								{t.type === 'team' && (
									<>
										<span class="tag">Equipos</span>{' '}
									</>
								)}
								{t.city && `${t.city} · `}
								{formatRange(t.startDate, t.endDate)}
							</span>
							{/* Los que no están en info64 (los de lichess) sólo guardan las partidas con
							    algún español: sin decirlo, una o dos de un open extranjero parecían poca cosa. */}
							<span class="muted num">
								{formatGames(t.gamesCount)}
								{t.source === 'lichess' && ' con españoles'}
							</span>
						</li>
					))}
				</ul>
			</section>
		)
	}
</Base>

<style>
	/*
	 * Ocupa todo el ancho, para el tablero, y lo que lleva dentro se queda en
	 * el de lectura. En el móvil el h1 queda a la altura del de las demás
	 * páginas; desde 40rem, con más aire bajo la cabecera. Los totales, cerca:
	 * dicen qué hay para buscar.
	 */
	.hero {
		position: relative;
		isolation: isolate;
		margin-block: 0 var(--space-5);
	}

	.hero > :global(*) {
		max-inline-size: var(--reading-width);
	}

	@media (width >= 40rem) {
		.hero {
			padding-block-start: var(--space-5);
		}
	}

	/*
	 * Un tablero de fondo, para que se vea a la primera que la web es de
	 * ajedrez: ocho columnas con las casillas del tablero (h8 oscura) en la
	 * esquina de arriba a la derecha, desde el borde de la cabecera (su margen
	 * es --space-6), que se desvanecen hacia el texto. En escritorio queda en el
	 * hueco junto al buscador; en el móvil, detrás del h1. Como mucho al 12 %: el
	 * gris queda a 5:1 sobre una casilla oscura en claro (5,7 sobre el fondo) y a
	 * 7:1 sobre el arce en oscuro. Fuera al imprimir y con más contraste.
	 */
	.hero::before {
		--casilla: 3rem;
		content: '';
		position: absolute;
		z-index: -1;
		inset-block: calc(-1 * var(--space-6)) 0;
		inset-inline-end: 0;
		inline-size: min(100%, 8 * var(--casilla));
		background: repeating-conic-gradient(var(--board-dark) 0 25%, var(--board-light) 0 50%);
		background-position: right top;
		background-size: calc(2 * var(--casilla)) calc(2 * var(--casilla));
		mask-image: radial-gradient(farthest-side at 100% 0, rgb(0 0 0 / 0.12), transparent);
	}

	@media print, (forced-colors: active), (prefers-contrast: more) {
		.hero::before {
			display: none;
		}
	}

	.hero h1 {
		font-size: var(--text-2xl);
	}

	/* En pantallas estrechas, sin una palabra sola en la última línea. */
	.hero h1 + p {
		text-wrap: pretty;
	}

	/*
	 * Campo y botón, siempre en una fila: el campo encoge (min-width: 0, porque
	 * un input mide de por sí unos 20 caracteres) y el botón conserva su texto.
	 */
	.search {
		display: flex;
		gap: var(--space-2);
		margin-block: var(--space-5) var(--space-3);
	}

	.search input {
		flex: 1;
		min-width: 0;
		min-height: var(--control-height-l);
		font-size: var(--text-l);
	}

	/* El único botón grande de la web: junto a un campo a --text-l, a --text-s se perdía. */
	.search .button {
		min-height: var(--control-height-l);
		font-size: var(--text-m);
	}

	.links {
		font-size: var(--text-s);
	}

	.totals {
		margin-bottom: var(--space-7);
		font-size: var(--text-s);
	}

	.totals span {
		white-space: nowrap;
	}

	/* min(100%, …): con la letra del navegador al 150 %, 18rem pasaban del ancho del móvil. */
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
		gap: var(--space-4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Las tarjetas de una fila miden lo mismo: las líneas, arriba, sin repartirse el alto. */
	.cards li {
		display: grid;
		align-content: start;
		gap: var(--space-1);
		font-size: var(--text-s);
	}

	.cards a {
		font-size: var(--text-m);
		font-weight: var(--weight-strong);
	}

	.more {
		margin-block: var(--space-4) 0;
		font-size: var(--text-s);
	}

	/*
	 * Las tres tarjetas del ejemplo caben en fila desde el mismo ancho que tres
	 * rondas (18rem cada una y los huecos), y entonces miden lo mismo que ellas.
	 * Con dos por fila, la tercera ocupa la fila entera: en una rejilla se
	 * quedaría sola, a media anchura. Las tablas piden unos 255 px: la que no
	 * cabe se desplaza dentro de su tarjeta, como en el dossier.
	 */
	.example {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
	}

	.example > .card {
		flex: 1 1 min(100%, 18rem);
		overflow-x: auto;
	}
</style>
