---
import { env } from 'cloudflare:workers'
import Icon from '../../components/Icon.astro'
import PlayerName from '../../components/PlayerName.astro'
import VisorPartida from '../../components/visor/VisorPartida.astro'
import Base from '../../layouts/Base.astro'
import { buildTree } from '../../lib/chess/movetree'
import { TIME_CLASS_LABEL } from '../../lib/chess/timecontrol'
import { gameRoundPage, getAdjacentGames, getGame } from '../../lib/db/games'
import { displayName, formatDate, formatResult } from '../../lib/format'
import { CC_BY, CC_BY_SA, fcaUrl, licensedPgn, lichessUrl } from '../../lib/licenses'
import { ME_COOKIE, isOwn, resolveMe } from '../../lib/me'
import { backTarget, boardColor, positiveInt, type BackKind } from '../../lib/params'
import { sourceUrl } from '../../lib/urls'

const id = positiveInt(Astro.params.id)
const game = id === null ? null : await getGame(env.DB, id)
if (!game) return Astro.rewrite('/404')

const [tree, adjacent] = [buildTree(game.pgn), await getAdjacentGames(env.DB, game)]
const headers = tree.headers
const white = {
	name: game.whiteName,
	fideId: game.whiteFideId,
	elo: game.whiteElo,
	title: headers.WhiteTitle ?? null
}
const black = {
	name: game.blackName,
	fideId: game.blackFideId,
	elo: game.blackElo,
	title: headers.BlackTitle ?? null
}
// Página de la partida en sus fuentes, para el crédito de debajo. La de lichess
// sale de sus cabeceras (lichessUrl), que también dicen si la partida es de
// lichess, como en el PGN que se descarga: también la de info64 que viene de
// lichess. En info64 cada partida tiene su página /{torneo}/{ronda}/{tablero}.
// Las del archivo de la FCA, igual, por su cabecera Source (fcaUrl); se enlaza
// la página del archivo. Sólo se enlaza si es de una fuente (sourceUrl).
const fromLichess = lichessUrl(game.pgn)
const fromFca = fcaUrl(game.pgn) !== null
const lichessHref = sourceUrl(fromLichess)
const sourceHref = sourceUrl(
	game.tournamentSource === 'info64' ? `${game.tournamentUrl}/${game.round}/${game.board}` : game.tournamentUrl
)
const title = `${displayName(game.whiteName)} – ${displayName(game.blackName)}`
// Lado del tablero: el que pide el enlace (desde la ficha, el dossier o el
// repertorio, el del jugador) o, si la partida es tuya (cookie yo), el tuyo.
const requested = boardColor(Astro.url.searchParams)
const me = resolveMe(null, Astro.cookies.get(ME_COOKIE)?.value)
const orientation = requested ?? (game.blackFideId !== null && isOwn(me, game.blackFideId) ? 'black' : 'white')
// Vuelta a la página de la que se viene, si es de la web: encima del título,
// como la de la ficha en el dossier y el repertorio. La ficha, el dossier y
// el repertorio de uno de los dos jugadores dicen de quién; los tuyos, en
// primera persona, como en sus páginas.
const BACK_LABELS: Record<Exclude<BackKind, 'game'>, string> = {
	search: 'a la búsqueda',
	games: 'a Partidas',
	tournament: 'al torneo',
	player: 'a la ficha',
	dossier: 'al dossier',
	repertoire: 'al repertorio'
}
const OWN_BACK_LABELS: Partial<Record<BackKind, string>> = {
	player: 'a mi ficha',
	dossier: 'a mi dossier',
	repertoire: 'a mi repertorio'
}

const backLink = async (): Promise<{ href: string; label: string } | null> => {
	const from = backTarget(Astro.request.headers.get('referer'), Astro.url)
	if (!from) return null
	// Tras «Anterior» o «Siguiente del torneo» se está recorriendo el torneo:
	// se vuelve a él, a la página de su lista en la que sale esta partida,
	// filtrada por su ronda. Desde otra partida, nada.
	if (from.kind === 'game') {
		if (from.id === null || (from.id !== adjacent.prev && from.id !== adjacent.next)) return null
		const page = await gameRoundPage(env.DB, game)
		const href = `/torneos/${game.tournamentId}?ronda=${game.round}${page > 1 ? `&p=${page}` : ''}#partidas`
		return { href, label: 'al torneo' }
	}
	const own = from.id !== null && isOwn(me, from.id) && OWN_BACK_LABELS[from.kind]
	const player = [white, black].find((p) => p.fideId !== null && p.fideId === from.id)
	const label = own || (player ? `${BACK_LABELS[from.kind]} de ${displayName(player.name)}` : BACK_LABELS[from.kind])
	return { href: from.href, label }
}

const back = await backLink()
---

<Base
	title={title}
	section="partidas"
	description={`${title}, ${formatResult(game.result)}. ${game.tournamentName}, ronda ${game.round}.`}
	canonical={`/partidas/${game.id}`}
	noindex={game.plyCount === 0}
>
	<header class="game-head page-head">
		{
			back && (
				<p class="back">
					<a href={back.href} data-back>
						← Volver {back.label}
					</a>
				</p>
			)
		}
		<h1>
			<PlayerName name={game.whiteName} fideId={game.whiteFideId} title={white.title} />{' '}
			<span class="result-big">{formatResult(game.result)}</span>{' '}
			<PlayerName name={game.blackName} fideId={game.blackFideId} title={black.title} />
		</h1>
		<p class="page-meta">
			<a href={`/torneos/${game.tournamentId}`}>{game.tournamentName}</a> · ronda {game.round}, mesa {game.board}
			{` · ${formatDate(game.date)}`}
			{game.timeClass && ` · ${TIME_CLASS_LABEL[game.timeClass]}`}
			{(game.eco || game.opening) && ' · '}
			{game.eco && <span class="eco">{game.eco}</span>}
			{game.eco && game.opening && ' '}
			{game.opening}
		</p>
	</header>

	<VisorPartida
		tree={tree}
		pgn={licensedPgn(game.pgn)}
		white={white}
		black={black}
		result={game.result}
		orientation={orientation}
	>
		<div class="game-actions">
			<div class="take">
				<a class="button secondary" href={`/partidas/${game.id}.pgn`} download>
					<Icon name="download" />
					Descargar PGN
				</a>
				<span class="copy">
					<button type="button" class="button secondary" data-action="copy-pgn">
						<Icon name="copy" />
						Copiar PGN
					</button>
					<span class="copied" role="status"></span>
				</span>
				<span class="copy">
					<button type="button" class="button secondary" data-action="copy-link" title="Enlace a esta jugada">
						<Icon name="copy" />
						Copiar enlace
					</button>
					<span class="copied" role="status"></span>
				</span>
				<span class="copy">
					<button type="button" class="button secondary" data-action="copy-fen" title="La posición del tablero">
						<Icon name="copy" />
						Copiar FEN
					</button>
					<span class="copied" role="status"></span>
				</span>
			</div>
			{
				(adjacent.prev || adjacent.next) && (
					<nav class="other-games" aria-label="Otras partidas del torneo">
						{adjacent.prev && (
							<a class="button secondary" href={`/partidas/${adjacent.prev}`} rel="prev">
								←&nbsp;Anterior del torneo
							</a>
						)}
						{adjacent.next && (
							<a class="button secondary" href={`/partidas/${adjacent.next}`} rel="next">
								Siguiente del torneo&nbsp;→
							</a>
						)}
					</nav>
				)
			}
		</div>
	</VisorPartida>
	<p class="muted credit">
		{
			fromLichess ? (
				<>
					Partida de una {lichessHref ? <a href={lichessHref}>retransmisión de lichess</a> : 'retransmisión de lichess'}
					{game.gamesSource === 'info64' && (
						<>
							{' '}
							publicada en {sourceHref ? <a href={sourceHref}>info64</a> : 'info64'} (FEDA)
						</>
					)}
					, con licencia <a href={CC_BY_SA} rel="license noopener">CC BY-SA 4.0</a>. Aquí se han completado sus
					cabeceras (nombres, FIDE ID, ELO y apertura).
				</>
			) : fromFca ? (
				<>
					Partida del{' '}
					{sourceHref ? (
						<a href={sourceHref}>archivo de la Federación Cántabra de Ajedrez</a>
					) : (
						'archivo de la Federación Cántabra de Ajedrez'
					)}
					, con licencia <a href={CC_BY} rel="license noopener">CC BY 4.0</a>. Aquí se han completado sus cabeceras y
					cada jugador se ha enlazado con su ficha FIDE por el nombre.
				</>
			) : game.tournamentSource === 'info64' ? (
				<>
					Partida de {sourceHref ? <a href={sourceHref}>info64</a> : 'info64'} (FEDA).
				</>
			) : (
				<>
					Partida de {sourceHref ? <a href={sourceHref}>su fuente</a> : 'su fuente'}.
				</>
			)
		}
	</p>
</Base>

<style>
	.game-head h1 {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-2) var(--space-3);
	}

	/*
	 * Los nombres enlazan a su ficha, pero en el color del texto, con su
	 * subrayado tenue: en el acento, dos nombres de 28 px eran lo que más
	 * llamaba la atención de la página, más que el tablero y la jugada actual.
	 * Al pasar por encima, el acento, como cualquier enlace.
	 */
	.game-head h1 :global(a) {
		color: var(--text);
	}

	.game-head h1 :global(a:hover) {
		color: var(--accent-hover);
	}

	.result-big {
		padding: 0 var(--space-2);
		border-radius: var(--radius-m);
		background: var(--surface-muted);
		font-variant-numeric: tabular-nums;
	}

	/*
	 * En el móvil, dos nombres y el resultado no caben en una línea: el
	 * resultado quedaba pegado a las blancas. Por debajo de 40rem va como en la
	 * lista de partidas: blancas encima de negras y el resultado a su derecha.
	 * Sólo se coloca el resultado: los nombres caen solos en la primera
	 * columna, y el orden del DOM (y el de lectura) sigue siendo «A 0-1 B».
	 */
	@media (width < 40rem) {
		.game-head h1 {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			gap: var(--space-1) var(--space-3);
			font-size: var(--text-l);
		}

		.result-big {
			grid-column: 2;
			grid-row: 1 / span 2;
			align-self: center;
		}
	}

	/*
	 * Barra de debajo del visor, en dos grupos: lo que te llevas de la partida
	 * (descargarla o copiarla) y moverte a otra del torneo. Botones con menos
	 * relleno, para que en el móvil quepan dos por fila; si aun así el texto
	 * parte línea (centrado y en líneas parejas, como todos los .button), cada
	 * flecha va pegada a su palabra por un espacio duro. Va dentro del visor,
	 * que la separa con el hueco de su rejilla.
	 */
	.game-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
	}

	.game-actions .button {
		padding-inline: var(--space-3);
	}

	.take,
	.other-games {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
	}

	/* El botón llena su .copy: en el móvil, la celda entera. */
	.copy > .button {
		flex-grow: 1;
	}

	/*
	 * En el móvil, un grupo debajo del otro y dos botones por fila, del mismo
	 * ancho y alto: «Siguiente del torneo →» parte línea a 375 px, y el de al
	 * lado crece con él. «Siguiente del torneo» siempre a la derecha, aunque
	 * no haya anterior.
	 */
	@media (width < 40rem) {
		.game-actions {
			flex-direction: column;
			align-items: stretch;
		}

		.take,
		.other-games {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			align-items: stretch;
		}

		.other-games [rel='next'] {
			grid-column: 2;
		}
	}

	.credit {
		margin-top: var(--space-4);
		font-size: var(--text-s);
	}
</style>
