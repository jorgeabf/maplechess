---
import { env } from 'cloudflare:workers'
import FiltrosPlegables from '../../components/FiltrosPlegables.astro'
import Pagination from '../../components/Pagination.astro'
import Segmented from '../../components/Segmented.astro'
import Base from '../../layouts/Base.astro'
import { madridDate } from '../../lib/dates'
import { searchTournaments } from '../../lib/db/tournaments'
import { formatDate, formatNumber, formatRange } from '../../lib/format'
import { tournamentFilters, withParams } from '../../lib/params'

const filters = tournamentFilters(Astro.url.searchParams)
const result = await searchTournaments(env.DB, filters, madridDate(new Date()))
// Pestañas: los ya empezados, por defecto, y los próximos, que no tienen
// partidas: al pasar a ellos se quita «Sólo con partidas».
const tabs = [
	{ id: '', label: 'En curso y terminados' },
	{ id: 'proximos', label: `Próximos (${formatNumber(result.upcoming)})` }
]
const tabHref = (id: string) => withParams(Astro.url, { cuando: id, p: null, ...(id ? { con_partidas: null } : {}) })
// «Quitar filtros» deja el nombre o el lugar, y la pestaña.
const filtered = Boolean(filters.from || filters.to || filters.type || filters.withGames)
const unfiltered = withParams(Astro.url, { desde: null, hasta: null, modalidad: null, con_partidas: null, p: null })
// Con resultados en la página, el formulario se pliega en el móvil y el resumen
// dice lo buscado; sin filas (una página de más), no.
const searchSummary = [
	filters.q,
	filters.type && (filters.type === 'team' ? 'por equipos' : 'individual'),
	filters.from && `desde el ${formatDate(filters.from)}`,
	filters.to && `hasta el ${formatDate(filters.to)}`,
	filters.withGames && 'sólo con partidas'
].filter((part): part is string => Boolean(part))
---

<Base title={filters.q ? `Torneos: ${filters.q}` : 'Torneos'} section="torneos">
	<h1>Torneos</h1>
	<div class="when">
		<Segmented label="Torneos" options={tabs} current={filters.upcoming ? 'proximos' : ''} href={tabHref} />
	</div>
	<FiltrosPlegables label="Búsqueda" summary={searchSummary} fold={searchSummary.length > 0 && result.rows.length > 0}>
		<form method="get" role="search" class="filters form-row">
			{filters.upcoming && <input type="hidden" name="cuando" value="proximos" />}
			<label class="grow">
				Nombre o lugar
				<input
					name="q"
					type="search"
					value={filters.q}
					placeholder="Campeonato, open, ciudad…"
					autocomplete="off"
					autocorrect="off"
					spellcheck="false"
					minlength="2"
				/>
			</label>
			<label>
				Desde
				<input name="desde" type="date" value={filters.from} />
			</label>
			<label>
				Hasta
				<input name="hasta" type="date" value={filters.to} />
			</label>
			<label>
				Modalidad
				<select name="modalidad">
					<option value="">Cualquiera</option>
					<option value="individual" selected={filters.type === 'individual'}>Individual</option>
					<option value="equipos" selected={filters.type === 'team'}>Por equipos</option>
				</select>
			</label>
			{
				!filters.upcoming && (
					<label class="check">
						<input type="checkbox" name="con_partidas" value="1" checked={filters.withGames} />
						Sólo con partidas
					</label>
				)
			}
			<button class="button" type="submit">Buscar</button>
			{filtered && <a href={unfiltered}>Quitar filtros</a>}
		</form>
	</FiltrosPlegables>

	{result.total > 0 && <Pagination page={result.page} pages={result.pages} total={result.total} noun={['torneo', 'torneos']} />}
	{
		result.rows.length > 0 ? (
			<div class="table-wrap stack">
				<table class="data-table">
					<thead>
						<tr>
							<th scope="col">Torneo</th>
							<th scope="col">Fechas</th>
							<th scope="col">Lugar</th>
							<th scope="col" class="end">Jugadores</th>
							{!filters.upcoming && <th scope="col" class="end">Partidas</th>}
						</tr>
					</thead>
					<tbody>
						{result.rows.map((t) => (
							<tr>
								<td class="wrap">
									<a href={`/torneos/${t.id}`}>{t.name}</a>
									{t.type === 'team' && (
										<>
											{' '}
											<span class="tag">Equipos</span>
										</>
									)}
								</td>
								<td class="num">{formatRange(t.startDate, t.endDate)}</td>
								<td>{t.city}</td>
								{/* Apilada en el móvil (.stack): cada cifra lleva su rótulo, sólo si la hay. */}
								<td class="end num">{t.players ? <><span class="cell-label" aria-hidden="true">Jugadores </span>{formatNumber(t.players)}</> : null}</td>
								{!filters.upcoming && <td class="end num">{t.gamesCount ? <><span class="cell-label" aria-hidden="true">Partidas </span>{formatNumber(t.gamesCount)}</> : null}</td>}
							</tr>
						))}
					</tbody>
				</table>
			</div>
		) : (
			<p>No hay torneos con esos filtros.</p>
		)
	}
	{result.pages > 1 && <Pagination page={result.page} pages={result.pages} total={result.total} noun={['torneo', 'torneos']} />}
</Base>

<style>
	/* El hueco de las pestañas al formulario, plegado o no. */
	.when {
		margin-bottom: var(--space-4);
	}

	.filters {
		margin-bottom: var(--space-4);
	}
</style>
