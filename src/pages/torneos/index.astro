---
import { env } from 'cloudflare:workers'
import FiltrosPlegables from '../../components/FiltrosPlegables.astro'
import Pagination from '../../components/Pagination.astro'
import Segmented from '../../components/Segmented.astro'
import Base from '../../layouts/Base.astro'
import { madridDate } from '../../lib/dates'
import { searchPairedTournaments, searchTournaments } from '../../lib/db/tournaments'
import { formatDate, formatNumber, formatRange, formatRoundTime } from '../../lib/format'
import { TOURNAMENT_TABS, tournamentFilters, withParams } from '../../lib/params'

const filters = tournamentFilters(Astro.url.searchParams)
const today = madridDate(new Date())
// Los emparejados tienen su consulta y su tabla: la ronda, cuándo empieza y sus mesas.
const paired = filters.when === 'paired' ? await searchPairedTournaments(env.DB, filters, today) : null
const listed = paired ? null : await searchTournaments(env.DB, filters, today)
const result = paired ?? listed!
// Pestañas: los ya empezados, por defecto; los próximos, que no tienen
// partidas, y los que tienen emparejada la próxima ronda: al pasar a ellos se
// quita «Sólo con partidas». Los emparejados van sin recuento: contarlos
// recorre pairings entera, y saldría en cada búsqueda de torneos.
const tab = TOURNAMENT_TABS[filters.when]
const tabs = [
	{ id: TOURNAMENT_TABS.started, label: 'En curso y terminados' },
	{ id: TOURNAMENT_TABS.upcoming, label: `Próximos (${formatNumber(result.upcoming)})` },
	{ id: TOURNAMENT_TABS.paired, label: 'Emparejados' }
]
const tabHref = (id: string) => withParams(Astro.url, { cuando: id, p: null, ...(id ? { con_partidas: null } : {}) })
// «Quitar filtros» deja el nombre o el lugar, y la pestaña.
const filtered = Boolean(filters.from || filters.to || filters.type || filters.withGames)
const unfiltered = withParams(Astro.url, { desde: null, hasta: null, modalidad: null, con_partidas: null, p: null })
// Con resultados en la página, el formulario se pliega en el móvil y el resumen
// dice lo buscado; sin filas (una página de más), no.
const searchSummary = [
	filters.q,
	filters.type && (filters.type === 'team' ? 'por equipos' : 'individual'),
	filters.from && `desde el ${formatDate(filters.from)}`,
	filters.to && `hasta el ${formatDate(filters.to)}`,
	filters.withGames && 'sólo con partidas'
].filter((part): part is string => Boolean(part))
---

<Base title={filters.q ? `Torneos: ${filters.q}` : 'Torneos'} section="torneos" noindex={Boolean(filters.q) || filtered}>
	<h1>Torneos</h1>
	<div class="when">
		<Segmented navigation label="Torneos" options={tabs} current={tab} href={tabHref} />
		<a href="/torneos/campeones">Campeones de España</a>
	</div>
	<FiltrosPlegables label="Búsqueda" summary={searchSummary} fold={searchSummary.length > 0 && result.rows.length > 0}>
		<form method="get" role="search" class="filters form-row">
			{tab && <input type="hidden" name="cuando" value={tab} />}
			<label class="grow">
				Nombre o lugar
				<input
					name="q"
					type="search"
					value={filters.q}
					placeholder="Campeonato, open, ciudad…"
					autocomplete="off"
					autocorrect="off"
					spellcheck="false"
					minlength="2"
				/>
			</label>
			<label>
				Desde
				<input name="desde" type="date" value={filters.from} />
			</label>
			<label>
				Hasta
				<input name="hasta" type="date" value={filters.to} />
			</label>
			<label>
				Modalidad
				<select name="modalidad">
					<option value="">Cualquiera</option>
					<option value="individual" selected={filters.type === 'individual'}>Individual</option>
					<option value="equipos" selected={filters.type === 'team'}>Por equipos</option>
				</select>
			</label>
			{
				filters.when === 'started' && (
					<label class="check">
						<input type="checkbox" name="con_partidas" value="1" checked={filters.withGames} />
						Sólo con partidas
					</label>
				)
			}
			<button class="button" type="submit">Buscar</button>
			{filtered && <a href={unfiltered}>Quitar filtros</a>}
		</form>
	</FiltrosPlegables>

	{result.total > 0 && <Pagination page={result.page} pages={result.pages} total={result.total} noun={['torneo', 'torneos']} />}
	{
		paired ? (
			paired.rows.length > 0 ? (
				<div class="table-wrap stack">
					<table class="data-table">
						<thead>
							<tr>
								<th scope="col">Torneo</th>
								<th scope="col" class="end">Ronda</th>
								<th scope="col">Empieza</th>
								<th scope="col">Lugar</th>
								<th scope="col" class="end">Mesas</th>
							</tr>
						</thead>
						<tbody>
							{paired.rows.map((t) => (
								<tr>
									<td class="wrap">
										<a href={`/torneos/${t.id}#proxima-ronda`}>{t.name}</a>
									</td>
									<td class="end num"><span class="cell-label" aria-hidden="true">Ronda </span>{t.round}</td>
									<td class="num">{formatRoundTime(t.startsAt)}</td>
									<td class="city">{t.city}</td>
									<td class="end num"><span class="cell-label" aria-hidden="true">Mesas </span>{formatNumber(t.boards)}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			) : (
				<p>
					{paired.total === 0 && !filters.q && !filtered
						? 'Ningún torneo tiene emparejada la próxima ronda.'
						: 'No hay torneos con esos filtros.'}
				</p>
			)
		) : listed!.rows.length > 0 ? (
			<div class="table-wrap stack">
				<table class="data-table">
					<thead>
						<tr>
							<th scope="col">Torneo</th>
							<th scope="col">Fechas</th>
							<th scope="col">Lugar</th>
							<th scope="col" class="end">Jugadores</th>
							{filters.when === 'started' && <th scope="col" class="end">Partidas</th>}
						</tr>
					</thead>
					<tbody>
						{listed!.rows.map((t) => (
							<tr>
								<td class="wrap">
									<a href={`/torneos/${t.id}`}>{t.name}</a>
									{t.type === 'team' && (
										<>
											{' '}
											<span class="tag">Equipos</span>
										</>
									)}
								</td>
								<td class="num">{formatRange(t.startDate, t.endDate)}</td>
								<td class="city">{t.city}</td>
								{/* Apilada en el móvil (.stack): cada cifra lleva su rótulo, sólo si la hay. */}
								<td class="end num">{t.players ? <><span class="cell-label" aria-hidden="true">Jugadores </span>{formatNumber(t.players)}</> : null}</td>
								{filters.when === 'started' && <td class="end num">{t.gamesCount ? <><span class="cell-label" aria-hidden="true">Partidas </span>{formatNumber(t.gamesCount)}</> : null}</td>}
							</tr>
						))}
					</tbody>
				</table>
			</div>
		) : (
			<p>No hay torneos con esos filtros.</p>
		)
	}
	{result.pages > 1 && <Pagination page={result.page} pages={result.pages} total={result.total} noun={['torneo', 'torneos']} />}
</Base>

<style>
	/*
	 * El hueco de las pestañas al formulario, plegado o no. Los campeones van
	 * junto a las pestañas, en su línea, y debajo si no caben (el móvil).
	 */
	.when {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2) var(--space-5);
		margin-bottom: var(--space-4);
	}

	.when > a {
		font-size: var(--text-s);
	}

	.filters {
		margin-bottom: var(--space-4);
	}
</style>
