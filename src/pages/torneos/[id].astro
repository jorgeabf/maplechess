---
import { env } from 'cloudflare:workers'
import Emparejamientos from '../../components/Emparejamientos.astro'
import GamesTable from '../../components/GamesTable.astro'
import Icon from '../../components/Icon.astro'
import IndicePagina from '../../components/IndicePagina.astro'
import Pagination from '../../components/Pagination.astro'
import PlayerName from '../../components/PlayerName.astro'
import Segmented from '../../components/Segmented.astro'
import Base from '../../layouts/Base.astro'
import { pointsTiebreaks, tiebreakLabel } from '../../lib/chess/tiebreaks'
import { TIME_CLASS_LABEL, timeClassOf } from '../../lib/chess/timecontrol'
import { madridDate } from '../../lib/dates'
import { getTournamentGames } from '../../lib/db/games'
import { getUpcomingRound } from '../../lib/db/pairings'
import { getTournamentStandings, standingsHeading } from '../../lib/db/standings'
import { getTournament, getTournamentParticipants, isIndexableTournament } from '../../lib/db/tournaments'
import { gameMatches } from '../../lib/encuentros'
import { formatCount, formatNumber, formatPoints, formatRange, formatRoundTime } from '../../lib/format'
import { CC_BY, CC_BY_SA } from '../../lib/licenses'
import { ME_COOKIE, resolveMe } from '../../lib/me'
import { dossierHref, pageParam, positiveInt, roundParam, withParams } from '../../lib/params'
import { sourceName, sourceUrl } from '../../lib/urls'

const id = positiveInt(Astro.params.id)
const tournament = id === null ? null : await getTournament(env.DB, id)
if (id === null || !tournament) return Astro.rewrite('/404')

const page = pageParam(Astro.url.searchParams.get('p'))
const round = roundParam(Astro.url.searchParams)
const isTeam = tournament.type === 'team'
// Torneo que no está en info64, sacado de su retransmisión (ingest/lichess/sync.ts).
const fromLichess = tournament.source === 'lichess'
// Del archivo de la Federación Cántabra (ingest/fca), con licencia CC BY 4.0.
const fromFca = tournament.source === 'fca'
const today = madridDate(new Date())
// En un torneo individual la clasificación sustituye a los participantes en
// cuanto la hay; en uno por equipos va encima de las plantillas. Los propios
// de lichess no tienen.
const standingsAndParticipants = async () => {
	if (fromLichess) return { standings: null, participants: await getTournamentParticipants(env.DB, id) }
	if (isTeam) {
		const [standings, participants] = await Promise.all([
			getTournamentStandings(env.DB, id, 'team'),
			getTournamentParticipants(env.DB, id)
		])
		return { standings, participants }
	}
	const standings = await getTournamentStandings(env.DB, id, 'individual')
	return { standings, participants: standings ? [] : await getTournamentParticipants(env.DB, id) }
}
const [{ standings, participants }, { rounds, games }, upcoming] = await Promise.all([
	standingsAndParticipants(),
	getTournamentGames(env.DB, id, round, page),
	getUpcomingRound(env.DB, id)
])
// Selector de ronda: todas, las numeradas y, al final, las que no traen ronda (0).
const roundOptions = [
	{ id: '', label: 'Todas' },
	...rounds.filter((r) => r.round > 0).map((r) => ({ id: String(r.round), label: String(r.round) })),
	...(rounds.some((r) => r.round === 0) ? [{ id: '0', label: 'Sin ronda' }] : [])
]
const roundHref = (option: string) => `${withParams(Astro.url, { ronda: option, p: null })}#partidas`
// Las del torneo, sea cual sea la ronda elegida.
const gamesTotal = rounds.reduce((sum, r) => sum + r.games, 0)
const timeClass = timeClassOf(tournament.timeControl)
// Sin cookie yo, la próxima ronda explica cómo recibir el aviso de las tuyas.
const me = resolveMe(null, Astro.cookies.get(ME_COOKIE)?.value).fideId
// Las plantillas de un torneo por equipos, por equipo.
const teams = [...Map.groupBy(participants, (p) => p.team).entries()]
// En uno individual con clasificación no se leen los participantes: cada fila
// de la clasificación es uno de ellos.
const players = standings && !isTeam ? standings.rows.length : participants.length
const indexable = isIndexableTournament(tournament.gamesCount, players)
// Las páginas del torneo y de su retransmisión, sólo si son de una fuente.
const tournamentUrl = sourceUrl(tournament.url)
const broadcastUrl = sourceUrl(tournament.gamesSourceUrl)
// Partidas de lichess que publica info64: las que el organizador sube tal como
// salen de su retransmisión (el CE Absoluto 2025), todas o sólo algunas. Las
// cuenta la ingesta al guardarlas (lichess_games), así que aquí no se leen los PGN.
const lichessShare =
	tournament.gamesSource === 'info64' && tournament.lichessGames > 0
		? tournament.lichessGames === tournament.gamesCount
			? 'Sus partidas son'
			: `${formatNumber(tournament.lichessGames)} de sus ${formatNumber(tournament.gamesCount)} partidas ${tournament.lichessGames === 1 ? 'es' : 'son'}`
		: null
const standingsTitle = standings && standingsHeading(standings, tournament.endDate, today)
// Los desempates que dan lo mismo que los puntos en todas las filas no salen
// en la tabla (en los torneos por equipos, los puntos de encuentro): la nota
// los sigue nombrando y dice por qué no están.
const repeated = standings ? pointsTiebreaks(standings) : []
const tiebreakColumns = standings ? standings.tiebreaks.flatMap((code, i) => (repeated.includes(i) ? [] : [{ code, i }])) : []
const repeatedCodes = repeated.map((i) => standings?.tiebreaks[i])
// «La publica info64, con los desempates del torneo por orden: BH (Buchholz), WON (partidas ganadas).»
const standingsNote =
	standings &&
	[
		`La publica ${tournament.source}`,
		standings.tiebreaks.length > 0
			? `, con los desempates del torneo por orden: ${standings.tiebreaks.map(tiebreakLabel).join(', ')}`
			: '',
		isTeam ? '.' : '. Nº es el número del ranking inicial.',
		repeatedCodes.length === 1 ? ` ${repeatedCodes[0]} no sale en la tabla: es la misma cifra que Pts.` : '',
		repeatedCodes.length > 1
			? ` ${new Intl.ListFormat('es').format(repeatedCodes.map(String))} no salen en la tabla: son la misma cifra que Pts.`
			: ''
	].join('')
// ELO medio de cada equipo, el de la clasificación (el que publica la fuente).
const teamRating = new Map(isTeam && standings ? standings.rows.map((s) => [s.name, s.rating]) : [])
// El encuentro de cada partida, de las plantillas, que ya están leídas.
const matches = isTeam ? gameMatches(games.rows, participants) : null

/*
 * Orden de las secciones: primero lo que resume el torneo, y las partidas
 * después. La próxima ronda, si la hay; la clasificación o, sin ella, los
 * participantes; las partidas, y las plantillas de un torneo por equipos al
 * final, porque son largas. Sin ninguna partida, «Partidas» va la última:
 * sólo dice por qué no las hay. El índice sale de esta misma lista.
 */
type Section = 'proxima-ronda' | 'clasificacion' | 'participantes' | 'partidas' | 'plantillas'
const sections = (
	[
		upcoming && 'proxima-ronda',
		standings && 'clasificacion',
		!isTeam && !standings && 'participantes',
		gamesTotal > 0 && 'partidas',
		isTeam && 'plantillas',
		gamesTotal === 0 && 'partidas'
	] as const
).filter((s): s is Section => typeof s === 'string')
const participantsLabel = fromLichess ? 'Jugadores' : 'Participantes'
const indexItems = sections.flatMap((s) => {
	switch (s) {
		case 'proxima-ronda':
			return [{ href: '#proxima-ronda', label: 'Emparejamientos' }]
		case 'clasificacion':
			return [{ href: '#clasificacion', label: 'Clasificación' }]
		case 'participantes':
			return [{ href: '#participantes', label: participantsLabel, count: participants.length }]
		case 'partidas':
			return gamesTotal > 0 ? [{ href: '#partidas', label: 'Partidas', count: gamesTotal }] : []
		case 'plantillas':
			return [{ href: '#participantes', label: 'Plantillas', count: formatCount(teams.length, 'equipo', 'equipos') }]
	}
})
---

<Base
	title={tournament.name}
	section="torneos"
	description={`${tournament.name}: ${standings ? 'clasificación' : 'participantes'} y partidas.`}
	canonical={`/torneos/${id}`}
	noindex={!indexable}
>
	<header class="page-head">
		<h1>{tournament.name}</h1>
		<p class="page-meta">
			{
				isTeam && (
					<>
						<span class="tag">Equipos</span>{' '}
					</>
				)
			}
			{tournament.city && `${tournament.city} · `}
			{formatRange(tournament.startDate, tournament.endDate)}
			{timeClass && ` · ${TIME_CLASS_LABEL[timeClass]}`}
			{tournament.timeControl && (timeClass ? ` (${tournament.timeControl})` : ` · ${tournament.timeControl}`)}
		</p>
		<p class="page-actions">
			{
				tournament.gamesCount > 0 && (
					<a class="button secondary" href={`/torneos/${id}.pgn`} download>
						<Icon name="download" />
						<span>
							Descargar PGN
							<span class="visually-hidden">
								{tournament.gamesCount === 1 ? ' de la partida' : ` de las ${formatNumber(tournament.gamesCount)} partidas`}
							</span>
						</span>
					</a>
				)
			}
			{
				tournamentUrl && (
					<a class="button secondary" href={tournamentUrl} rel="noopener">
						Ver en {sourceName(tournament.source)}
					</a>
				)
			}
		</p>
	</header>

	<IndicePagina items={indexItems} />

	{
		sections.map((section) => (
			<>
				{section === 'proxima-ronda' && upcoming && (
					<section id="proxima-ronda">
						<h2>
							Emparejamientos de la ronda {upcoming.round} · {formatRoundTime(upcoming.startsAt)}
						</h2>
						<p class="muted">
							Publicados en {tournament.source}. «Preparar» abre el dossier del jugador con el color que lleva.
							{!me && ' ¿Juegas? Pulsa tu nombre y, en tu ficha, «Soy yo»: la portada te avisará de cada ronda.'}
						</p>
						<Emparejamientos groups={[{ pairings: upcoming.pairings }]} boardIds />
					</section>
				)}

				{section === 'clasificacion' && standings && (
					<section id="clasificacion">
						<h2>{standingsTitle}</h2>
						<p class="muted">{standingsNote}</p>
						<div class="table-wrap compact standings">
							<table class="data-table">
								<thead>
									<tr>
										<th scope="col" class="end">Pos.</th>
										<th scope="col">{isTeam ? 'Equipo' : 'Jugador'}</th>
										<th scope="col" class="end">Pts.</th>
										{tiebreakColumns.map(({ code }) => (
											<th scope="col" class="end">
												{code}
											</th>
										))}
										<th scope="col" class="end">{isTeam ? 'ELO medio' : 'ELO'}</th>
										{!isTeam && (
											<>
												<th scope="col">Fed.</th>
												<th scope="col" class="end">Nº</th>
											</>
										)}
									</tr>
								</thead>
								<tbody>
									{standings.rows.map((s) => (
										<tr>
											<td class="end num">{s.pos}</td>
											<td class="name">
												{isTeam || !s.name ? (
													s.name
												) : (
													<>
														<PlayerName name={s.name} title={s.title} fideId={s.fideId} />
														{s.fideId && s.hasDossier === 1 && (
															<span class="prepare">
																{' '}
																·{' '}
																<a href={dossierHref(s.fideId)} rel="nofollow">
																	preparar
																</a>
															</span>
														)}
													</>
												)}
											</td>
											<td class="end num">{formatPoints(s.points)}</td>
											{tiebreakColumns.map(({ i }) => (
												<td class="end num">{s.tiebreaks[i] === null ? '' : formatNumber(s.tiebreaks[i])}</td>
											))}
											<td class="end num">{s.rating}</td>
											{!isTeam && (
												<>
													<td>{s.fed}</td>
													<td class="end num">{s.startRank}</td>
												</>
											)}
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</section>
				)}

				{section === 'participantes' && (
					<section id="participantes">
						<h2>
							{participantsLabel} ({formatNumber(participants.length)})
						</h2>
						{fromLichess && <p class="muted">Los de sus partidas, numerados por ELO.</p>}
						{participants.length > 0 ? (
							<div class="table-wrap compact participants">
								<table class="data-table">
									<thead>
										<tr>
											<th scope="col" class="end">Nº</th>
											<th scope="col">Jugador</th>
											<th scope="col">Fed.</th>
											<th scope="col" class="end">ELO</th>
											<th scope="col" class="end">FIDE ID</th>
										</tr>
									</thead>
									<tbody>
										{participants.map((p) => (
											<tr>
												{/* Apilada en una pantalla muy estrecha: cada cifra lleva su rótulo, sólo si la hay. */}
												<td class="end num"><span class="cell-label" aria-hidden="true">Nº </span>{p.startRank}</td>
												<td class="name">
													<PlayerName name={p.name} title={p.title} fideId={p.fideId} />
													{p.fideId && p.hasDossier === 1 && (
														<span class="prepare">
															{' '}
															·{' '}
															<a href={dossierHref(p.fideId)} rel="nofollow">
																preparar
															</a>
														</span>
													)}
												</td>
												<td>{p.fed}</td>
												<td class="end num">{p.rating && <><span class="cell-label" aria-hidden="true">ELO </span>{p.rating}</>}</td>
												<td class="end num">{p.fideId && <><span class="cell-label" aria-hidden="true">FIDE ID </span>{p.fideId}</>}</td>
											</tr>
										))}
									</tbody>
								</table>
							</div>
						) : (
							<p class="muted">La fuente no publica la lista de participantes.</p>
						)}
					</section>
				)}

				{section === 'partidas' && (
					<section id="partidas">
						<h2>Partidas</h2>
						{fromLichess ? (
							<p class="muted">
								Este torneo no está en info64. Sus partidas vienen de su{' '}
								{tournamentUrl ? (
									<a href={tournamentUrl} rel="noopener">retransmisión oficial en lichess</a>
								) : (
									'retransmisión oficial en lichess'
								)}{' '}
								y sólo están las que juega algún
								jugador español. Licencia <a href={CC_BY_SA} rel="license noopener">CC BY-SA 4.0</a>.
							</p>
						) : tournament.gamesSource === 'lichess' ? (
							<p class="muted">
								{tournament.source} no publica las partidas de este torneo; vienen de su{' '}
								{broadcastUrl ? (
									<a href={broadcastUrl} rel="noopener">retransmisión en lichess</a>
								) : (
									'retransmisión en lichess'
								)}
								, que suele cubrir sólo las mesas con tablero electrónico. Licencia{' '}
								<a href={CC_BY_SA} rel="license noopener">CC BY-SA 4.0</a>.
							</p>
						) : fromFca ? (
							<p class="muted">
								Sus partidas son del{' '}
								{tournamentUrl ? (
									<a href={tournamentUrl} rel="noopener">archivo de la Federación Cántabra de Ajedrez</a>
								) : (
									'archivo de la Federación Cántabra de Ajedrez'
								)}
								, con licencia <a href={CC_BY} rel="license noopener">CC BY 4.0</a>. Aquí se han separado por torneo y cada
								jugador se ha enlazado con su ficha FIDE por el nombre, sólo cuando casa con uno solo.
							</p>
						) : (
							lichessShare && (
								<p class="muted">
									{lichessShare} de una retransmisión de lichess publicada en info64 (FEDA), con licencia{' '}
									<a href={CC_BY_SA} rel="license noopener">CC BY-SA 4.0</a>.
								</p>
							)
						)}
						{rounds.length > 1 && (
							<div class="selectors">
								<Segmented showLabel label="Ronda" options={roundOptions} current={round === null ? '' : String(round)} href={roundHref} />
							</div>
						)}
						{games.total > 0 ? (
							<>
								<GamesTable games={games.rows} hideTournament match={matches ? (g) => matches.get(g.id) : undefined} />
								<Pagination page={games.page} pages={games.pages} total={games.total} noun={['partida', 'partidas']} anchor="partidas" />
							</>
						) : (
							<p class="muted">
								{gamesTotal > 0
									? 'No hay partidas de esa ronda.'
									: tournament.startDate !== null && tournament.startDate > today
										? 'Aún no ha empezado.'
										: 'La fuente no ha publicado partidas de este torneo.'}
							</p>
						)}
					</section>
				)}

				{section === 'plantillas' && (
					<section id="participantes">
						<h2>
							Plantillas ({formatCount(participants.length, 'jugador', 'jugadores')},{' '}
							{formatCount(teams.length, 'equipo', 'equipos')})
						</h2>
						{participants.length > 0 ? (
							<div class="teams">
								{teams.map(([team, members]) => {
									const rating = teamRating.get(team)
									return (
										<details class="team">
											<summary>
												<span class="team-name">{team}</span>
												<span class="team-meta">
													{formatCount(members.length, 'jugador', 'jugadores')}
													{rating && ` · ELO medio ${rating}`}
												</span>
											</summary>
											<div class="table-wrap compact participants">
												<table class="data-table">
													<thead>
														<tr>
															<th scope="col" class="end">Tablero</th>
															<th scope="col">Jugador</th>
															<th scope="col">Fed.</th>
															<th scope="col" class="end">ELO</th>
															<th scope="col" class="end">FIDE ID</th>
														</tr>
													</thead>
													<tbody>
														{members.map((p) => (
															<tr>
																<td class="end num"><span class="cell-label" aria-hidden="true">Tablero </span>{p.startRank}</td>
																<td class="name">
																	<PlayerName name={p.name} title={p.title} fideId={p.fideId} />
																	{p.fideId && p.hasDossier === 1 && (
																		<span class="prepare">
																			{' '}
																			·{' '}
																			<a href={dossierHref(p.fideId)} rel="nofollow">
																				preparar
																			</a>
																		</span>
																	)}
																</td>
																<td>{p.fed}</td>
																<td class="end num">{p.rating && <><span class="cell-label" aria-hidden="true">ELO </span>{p.rating}</>}</td>
																<td class="end num">{p.fideId && <><span class="cell-label" aria-hidden="true">FIDE ID </span>{p.fideId}</>}</td>
															</tr>
														))}
													</tbody>
												</table>
											</div>
										</details>
									)
								})}
							</div>
						) : (
							<p class="muted">La fuente no publica la lista de participantes.</p>
						)}
					</section>
				)}
			</>
		))
	}
</Base>

<style>
	/* Al tamaño del nombre, con relleno: la zona que se pulsa llega a los 24 px. */
	.prepare a {
		padding-block: var(--space-1);
	}

	/*
	 * Clasificación y participantes, como el ranking de /jugadores: el nombre
	 * parte línea (su mínimo es la palabra más larga) y, en un hueco de menos de
	 * 26rem, el relleno se estrecha. A 375 px la de participantes pedía 544 px
	 * de 342 y el ELO quedaba fuera; así se ven el número, el nombre, la
	 * federación y el ELO, y sólo el FIDE ID puede quedar tras el scroll (más
	 * estrecho, la de participantes se apila: ver abajo). En la
	 * clasificación, el puesto, el nombre y los puntos; los desempates, detrás.
	 */
	.compact {
		container-type: inline-size;
	}

	.compact td.name {
		white-space: normal;
	}

	@container (width < 26rem) {
		.compact :is(th, td) {
			padding-inline: var(--space-2);
		}
	}

	/*
	 * Con los desempates, la clasificación no cabe en el móvil: cada columna se
	 * queda en su mínimo y el nombre, en su palabra más larga (unos 90 px, en
	 * tres o cuatro líneas). Por debajo de 30rem, donde ya se desplazaba en las
	 * medidas (CE 2025, Xàbia, Bizkaia y la División de Honor), el nombre se
	 * lleva al menos 10rem o el 45 % del hueco. A 375 px pasa a 145 px, y los
	 * puntos quedan a la vista; por encima no cambia nada.
	 */
	@container (width < 30rem) {
		.standings td.name {
			min-width: min(10rem, 45cqi);
		}
	}

	/*
	 * Participantes en una pantalla muy estrecha (250 px, o 375 con la letra al
	 * 150 %): ni sin el FIDE ID cabían el número, el nombre, la federación y el
	 * ELO, que piden de 190 a 279 px (30 torneos medidos el 24-oct-2026), y el
	 * ELO quedaba tras el scroll. Por debajo de 17,5rem cada jugador pasa a un
	 * bloque, como en los listados apilados (.stack): el nombre a todo el ancho
	 * y, debajo y en pequeño, las demás celdas, cada cifra con su rótulo.
	 */
	@container (width < 17.5rem) {
		.participants thead {
			position: absolute;
			inline-size: 1px;
			block-size: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}

		.participants tr {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			gap: var(--space-1) var(--space-3);
			padding: var(--space-2);
			border-bottom: 1px solid var(--border);
		}

		.participants tbody > tr:last-child {
			border-bottom: 0;
		}

		.participants td {
			padding: 0;
			border-bottom: 0;
			font-size: var(--text-xs);
			white-space: normal;
		}

		.participants td.name {
			order: -1;
			flex-basis: 100%;
			font-size: var(--text-s);
		}

		/* La federación no lleva rótulo: en gris, como las fechas en .stack. */
		.participants td:not(.name, :has(.cell-label)) {
			color: var(--text-muted);
		}

		.participants td:empty {
			display: none;
		}

		.participants .cell-label {
			display: inline;
			color: var(--text-muted);
		}
	}

	/*
	 * Plantillas de un torneo por equipos: un equipo por fila, plegado, con su
	 * número de jugadores y su ELO medio. Abiertas medían 20.441 px a 375 en
