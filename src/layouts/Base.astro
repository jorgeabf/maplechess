---
import compartir from '../assets/compartir.png'
import titularesUrl from '../assets/fonts/titulares-600.woff2'
import BuscadorJugadores from '../components/BuscadorJugadores.astro'
import Icon from '../components/Icon.astro'
import Logo from '../components/Logo.astro'
import { CC_BY_SA, SOURCE_CODE } from '../lib/licenses'
import { THEME_COLOR } from '../lib/theme-color'
import { canonicalHref } from '../lib/urls'
import '../styles/global.css'

interface Props {
	/** Base le añade el nombre del sitio detrás, salvo si ya empieza por él (la portada). */
	title: string
	description?: string
	/** Sección activa del menú. */
	section?: 'jugadores' | 'partidas' | 'torneos'
	/** Las fichas vacías, las partidas sin jugadas y las búsquedas no se indexan. */
	noindex?: boolean
	/**
	 * Ruta canónica. Las páginas de un jugador, un torneo o una partida la hacen
	 * con su ID: la pedida puede llevar ceros delante o basura detrás
	 * (positiveInt la acepta). Por defecto, la pedida.
	 */
	canonical?: string
}

const {
	title,
	description = 'Buscador de jugadores españoles de ajedrez y de sus partidas, con visor y motor de análisis.',
	section,
	noindex = false,
	canonical = Astro.url.pathname
} = Astro.props
const siteName = 'MapleChess'
const fullTitle = title.startsWith(siteName) ? title : `${title} · ${siteName}`
const site = Astro.site ?? Astro.url
// Sin query: los filtros, la página y la ronda son variantes de la misma
// página. Lo que no se indexa no lleva canonical: serían señales contrarias.
const canonicalUrl = noindex ? null : canonicalHref(canonical, site)

const nav = [
	{ href: '/jugadores', label: 'Jugadores', id: 'jugadores' },
	{ href: '/partidas', label: 'Partidas', id: 'partidas' },
	{ href: '/torneos', label: 'Torneos', id: 'torneos' }
] as const
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		{/* viewport-fit=cover: la página llega hasta el borde de abajo, también bajo
		    la barra de gestos de Android (sin la barra de Chrome encima) y, en
		    horizontal, hasta los lados de la muesca. Lo que toca un borde deja su
		    env(safe-area-inset-*): la cabecera, .page, el pie y el buscador. */}
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		{/* Barras del navegador del color del fondo de la página, el que pone también
		    Safari 26 (lib/theme-color.ts explica por qué no el de la cabecera). */}
		<meta name="theme-color" media="(prefers-color-scheme: light)" content={THEME_COLOR.light} />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content={THEME_COLOR.dark} />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		{/* Vista previa al compartir un enlace. El título va sin el nombre del
		    sitio, que lleva og:site_name; sin canonical, se usa la URL pedida.
		    La tarjeta sale de scripts/iconos.mjs; importada, lleva hash y cambia
		    de URL si se regenera, así que nadie se queda con la vieja. */}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		<meta property="og:image" content={new URL(compartir.src, site).href} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content={String(compartir.width)} />
		<meta property="og:image:height" content={String(compartir.height)} />
		<meta property="og:image:alt" content={siteName} />
		<meta name="twitter:card" content="summary_large_image" />
		{/* El ICO con sizes="32x32": así los navegadores que leen SVG se quedan con
		    el SVG. El ICO y el icono de iOS salen de scripts/iconos.mjs. */}
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		{/* Para instalarla como app web (lib/manifest.ts). */}
		<link rel="manifest" href="/manifest.webmanifest" />
		{/* La marca y el h1 van en serif nada más cargar: la fuente se pide a la vez que el CSS. */}
		<link rel="preload" href={titularesUrl} as="font" type="font/woff2" crossorigin />
	</head>
	<body>
		<a class="skip" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<div class="page bar">
				<a class="brand" href="/">
					<Logo size={40} />
					<span>{siteName}</span>
				</a>
				<div class="end">
					<nav class="tabs" aria-label="Secciones">
						<ul>
							{
								nav.map((item) => (
									<li>
										<a href={item.href} aria-current={section === item.id ? 'page' : undefined}>
											{item.label}
										</a>
									</li>
								))
							}
						</ul>
					</nav>
					{/* Popover nativo: se abre sin JS, con el campo enfocado, y se cierra con Esc o tocando fuera. */}
					<button class="search-toggle" type="button" popovertarget="buscar-jugador">
						<Icon name="search" />
						<span class="visually-hidden">Buscar jugador</span>
					</button>
					<BuscadorJugadores id="buscar-jugador" popover="auto" autofocus>
						<button class="button secondary" type="button" popovertarget="buscar-jugador" popovertargetaction="hide">
							Cerrar
						</button>
					</BuscadorJugadores>
					{/* Lo cierra también cuando el foco sale de él (src/client/panel-busqueda.ts). */}
					<script src="../client/panel-busqueda.ts"></script>
				</div>
			</div>
		</header>
		<main id="contenido" class="page">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="page">
				<div class="footer-main">
					<div class="footer-about">
						<a class="footer-brand" href="/">
							<Logo size={32} />
							<span>{siteName}</span>
						</a>
						<p>Jugadores, torneos y partidas del ajedrez español, para preparar a tu próximo rival.</p>
					</div>
					{/* Las secciones salen de la lista del menú, detrás de la portada, que es
					    donde se empieza a preparar una partida. Lo que es del sitio, aparte. */}
					<nav class="footer-nav" aria-label="Pie de página">
						<ul>
							<li><a href="/">Prepara tu partida</a></li>
							{
								nav.map((item) => (
									<li>
										<a href={item.href}>{item.label}</a>
									</li>
								))
							}
						</ul>
						<ul>
							<li><a href="/acerca">Acerca de</a></li>
							<li><a href="/privacidad">Privacidad</a></li>
							<li><a href="/aviso-legal">Aviso legal</a></li>
						</ul>
					</nav>
				</div>
				{/* {' '} explícitos: Astro, como JSX, quita el espacio con salto de línea entre texto y etiqueta. */}
				<p class="credits">
					Datos de <a href="https://info64.org" rel="noopener">info64</a> (FEDA), de la{' '}
					<a href="https://ratings.fide.com" rel="noopener">lista FIDE</a> y de las{' '}
					<a href="https://lichess.org/broadcast" rel="noopener">retransmisiones de lichess</a> (
					<a class="license" href={CC_BY_SA} rel="license noopener">CC BY-SA 4.0</a>). Motor{' '}
					<a href="https://stockfishchess.org" rel="noopener">Stockfish</a>.{' '}
					<a href={SOURCE_CODE} rel="noopener">Código libre</a> bajo <span class="license">GPL-3.0</span>.
				</p>
			</div>
		</footer>
	</body>
</html>

<style>
	.skip {
		position: absolute;
		inset-inline-start: var(--space-4);
		inset-block-start: calc(-1 * var(--space-8));
		padding: var(--space-2) var(--space-3);
		background: var(--accent);
		color: var(--text-inverse);
		border-radius: var(--radius-m);
		z-index: 10;
	}

	.skip:focus {
		inset-block-start: var(--space-2);
	}

	/* Con viewport-fit=cover, el fondo llega al borde de arriba y el contenido
	   queda por debajo de lo que lo tape (en el navegador, nada: vale 0). */
	.site-header {
		border-bottom: 1px solid var(--border);
		background: var(--surface);
		margin-bottom: var(--space-6);
		padding-block-start: env(safe-area-inset-top, 0px);
	}

	/*
	 * Marca y menú comparten fila mientras quepan. Si no, el menú baja solo,
	 * sin punto de corte: el salto de línea de flexbox mide su contenido
	 * entero, así que no hay que tocar nada al añadir secciones. Solo en su
	 * línea, space-between lo deja al principio; y si ni así cabe, encoge
	 * (min-width: 0) y las pestañas se desplazan en horizontal.
	 */
	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: stretch;
		justify-content: space-between;
		column-gap: var(--space-5);
	}

	/*
	 * El logo, el relleno y el hueco crecen con la pantalla, de 320 a 640 px de
	 * ancho, y el nombre con --text-xl. En escritorio la cabecera mide 64 px,
	 * con el logo a 40; en el móvil, donde el menú va en otra fila, la de la
	 * marca se queda en 51 px a 375, con el logo a 33. Con la altura de línea
	 * de los titulares, el nombre no pasa del alto del logo.
	 */
	.brand {
		--logo: clamp(2rem, 1.5rem + 2.5vw, 2.5rem);
		--aire: clamp(var(--space-2), 0.25rem + 1.25vw, var(--space-3));
		display: inline-flex;
		align-items: center;
		gap: var(--aire);
		padding-block: var(--aire);
		font-family: var(--font-serif);
		font-size: var(--text-xl);
		font-weight: var(--weight-strong);
		line-height: 1.2;
		color: var(--text);
		text-decoration: none;
	}

	.brand :global(.logo) {
		inline-size: var(--logo);
		block-size: var(--logo);
	}

	/*
	 * Menú y lupa van juntos: a la derecha de la marca si caben con ella y, si
	 * no, juntos en la fila siguiente, al principio. Si ni así caben las
	 * pestañas, el menú encoge y se desplaza; la lupa queda siempre a la vista.
	 */
	.end {
		/* Grosor del subrayado de la pestaña. */
		--marca: 3px;
		display: flex;
		min-width: 0;
	}

	.tabs {
		display: flex;
		min-width: 0;
	}

	/*
	 * La lista es la zona que se desplaza. Por la izquierda llega hasta el
	 * borde de la pantalla (margen negativo) y su padding deja el texto de la
	 * primera pestaña a plomo con el logo. Por la derecha acaba en la lupa.
	 */
	.tabs ul {
		display: flex;
		margin: 0;
		margin-inline-start: calc(-1 * var(--space-4));
		padding: 0;
		padding-inline-start: calc(var(--space-4) - var(--space-3));
		list-style: none;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: none;
	}

	.tabs li {
		display: flex;
	}

	/* El borde va arriba y abajo para que el texto quede centrado; el de abajo
	   es el subrayado, que en la fila de la marca toca el borde de la cabecera. */
	.tabs a {
		display: flex;
		align-items: center;
		padding: var(--space-2) var(--space-3);
		border-block: var(--marca) solid transparent;
		color: var(--text-muted);
		text-decoration: none;
		font-weight: var(--weight-strong);
		white-space: nowrap;
	}

	/* La lista recorta lo que sale de ella por arriba y por abajo: el anillo de
	   foco, del mismo grosor que el global, va por dentro. */
	.tabs a:focus-visible {
		outline-offset: -2px;
	}

	.tabs a:hover {
		border-block-end-color: var(--border-strong);
		color: var(--text);
	}

	.tabs a[aria-current='page'] {
		border-block-end-color: var(--accent);
		color: var(--accent);
	}

	/*
	 * La lupa, como una pestaña más. Su margen negativo deja el icono a plomo
	 * con el borde del contenido, como el logo al otro lado.
	 */
	.search-toggle {
		display: flex;
		align-items: center;
		margin-inline-end: calc(-1 * var(--space-3));
		padding: var(--space-2) var(--space-3);
		border: 0;
		border-block: var(--marca) solid transparent;
		background: none;
		color: var(--text-muted);
		cursor: pointer;
	}

	.search-toggle:hover {
		border-block-end-color: var(--border-strong);
		color: var(--text);
	}

	/* En alto contraste el sistema pinta los bordes transparentes con el color
	   de los enlaces: se funden con el fondo y la activa se marca con el de
	   selección. */
	@media (forced-colors: active) {
		.tabs a,
		.search-toggle {
			border-color: Canvas;
		}

		.tabs a[aria-current='page'] {
			border-block-end-color: Highlight;
		}
	}

	main {
		flex: 1;
		padding-bottom: var(--space-7);
	}

	/*
	 * Pie: la marca y qué es la web, los enlaces y, debajo, las atribuciones.
	 * Con el fondo y la raya de la cabecera, que así enmarcan la página. Al
	 * final del scroll, el texto queda por encima de la barra de gestos.
	 */
	.site-footer {
		border-top: 1px solid var(--border);
		background: var(--surface);
		padding-block: var(--space-6) calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
		font-size: var(--text-s);
		color: var(--text-muted);
	}

	/*
	 * Marca y enlaces comparten fila mientras quepan; si no, los enlaces bajan,
	 * sin punto de corte. Una sección más alarga su lista, y una lista más se
	 * pone al lado de las otras o debajo, sin tocar nada.
	 */
	.footer-main {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-5) var(--space-7);
	}

	.footer-about {
		flex: 0 1 22rem;
		display: grid;
		align-content: start;
		gap: var(--space-3);
	}

	.footer-about p {
		margin: 0;
	}

	/* La marca de la cabecera, en pequeño. Sin justify-self, el enlace llenaría la columna. */
	.footer-brand {
		display: inline-flex;
		align-items: center;
		justify-self: start;
		gap: var(--space-2);
		font-family: var(--font-serif);
		font-size: var(--text-l);
		font-weight: var(--weight-strong);
		line-height: 1.2;
		color: var(--text);
		text-decoration: none;
	}

	/* Las listas, arriba: estiradas al alto de la más larga, la rejilla de la
	   corta repartiría el hueco entre sus filas. */
	.footer-nav {
		display: flex;
		flex-wrap: wrap;
		align-items: start;
		gap: var(--space-4) var(--space-7);
	}

	.footer-nav ul {
		display: grid;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.credits {
		margin: var(--space-5) 0 0;
		padding-top: var(--space-4);
		border-top: 1px solid var(--border);
	}

	/* El nombre de una licencia, entero: a 250 px quedaba «GPL-» al final de una línea y «3.0» en la siguiente. */
	.license {
		white-space: nowrap;
	}

	/* En papel sobran el menú y el pie; la marca queda para saber de dónde sale. */
	@media print {
		.site-header {
			margin-bottom: var(--space-4);
			background: none;
		}

		.tabs,
		.search-toggle,
		.site-footer,
		.skip {
			display: none;
		}
	}
</style>
